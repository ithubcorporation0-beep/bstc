# Canonical Site Base URL
# Local Development: http://localhost:3000
# Production: https://bstc.com.pk
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend Email Delivery API Key (https://resend.com/api-keys)
RESEND_API_KEY=

# Optional: Verified sender email (defaults to onboarding@resend.dev during development)
RESEND_FROM_EMAIL=

# Optional: Recipient email for consultation notifications (defaults to settings.ts email)
CONTACT_NOTIFICATION_EMAIL=
